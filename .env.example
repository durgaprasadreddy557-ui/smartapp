# ==========================================
# SMART CAMPUS - Environment Configuration
# ==========================================

# Supabase Project Credentials
# Obtain these from your Supabase Dashboard: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (Backend API / Admin actions only - NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Application Base URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Campus Meta
NEXT_PUBLIC_CAMPUS_NAME="Smart Campus Institute of Technology"
